# Copia este archivo como .env y ajusta los valores. El .env nunca se sube a Git.

# Base de datos de desarrollo (docker compose up -d db, en la raíz del repositorio).
DATABASE_URL=postgresql+psycopg://inclutec:inclutec_dev@localhost:5432/inclutec

# Base de datos de pruebas: se recrea sola en cada corrida de pytest. Usa un servidor PostgreSQL 16
# donde el usuario pueda crear bases de datos.
TEST_DATABASE_URL=postgresql+psycopg://inclutec:inclutec_dev@localhost:5432/inclutec_pruebas

# Firma de los JWT (HS256). Cámbiala por una cadena larga y aleatoria.
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
JWT_HORAS=8

# bcrypt: cost 10 o más.
BCRYPT_COST=12

# Carpeta donde se guardan fotos, logotipos y constancias.
ARCHIVOS_DIR=uploads

# Correo de desarrollo (Mailpit: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_REMITENTE=no-responder@inclutec.mx

# Cada cuántos segundos busca entrevistas a 24 horas para mandar el recordatorio (0 = apagado).
RECORDATORIOS_CADA_SEGUNDOS=300
