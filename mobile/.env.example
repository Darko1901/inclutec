# URL base del API. Vacía: la app usa la IP de la computadora desde la que Expo la sirvió, con el
# puerto 8000 (si el módem te cambia la IP, la app la sigue sola). Pon una URL solo si el API
# corre en otra máquina o usas `expo start --tunnel`.
EXPO_PUBLIC_API_URL=

# true = datos simulados (no necesita API); false = llama al API real.
EXPO_PUBLIC_USE_MOCK=true
