APP_NAME=IncluTec
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Idioma y zona horaria: español de México. Las fechas del API vienen en UTC y la app
# las muestra en hora de la Ciudad de México (zona fijada en config/app.php).
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=es_MX

# El panel no tiene base de datos: sesiones y caché en archivos y sin colas reales.
SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# API REST de IncluTec (la única que habla con la base de datos).
INCLUTEC_API_URL=http://localhost:8000/api/v1

# true  = el panel usa datos simulados (los de db/semillas/S002__datos_prueba.sql).
# false = el panel llama al API real de INCLUTEC_API_URL.
INCLUTEC_API_MOCK=true
